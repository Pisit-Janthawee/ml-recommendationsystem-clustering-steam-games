<mxfile host="app.diagrams.net" pages="1"><diagram name="Steam recommendation system and clustering" id="recommender_architecture"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="760" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Steam recommendation system and clustering" style="text;html=1;align=center;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1500" height="35" as="geometry"/></mxCell><mxCell id="csv" value="Kaggle data&lt;br&gt;steam.csv (27,075 games)&lt;br&gt;descriptions&lt;br&gt;player tag votes (371 tags)&lt;br&gt;header images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="230" height="120" as="geometry"/></mxCell><mxCell id="clean" value="Data cleansing&lt;br&gt;hidden gaps, duplicates,&lt;br&gt;flags (&lt; 50 ratings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="95" width="200" height="70" as="geometry"/></mxCell><mxCell id="text" value="Text normalization&lt;br&gt;HTML, links, stopwords,&lt;br&gt;Porter stemming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="230" height="70" as="geometry"/></mxCell><mxCell id="tfidf" value="TF-IDF on descriptions&lt;br&gt;50,000 words + bigrams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="tags" value="Tag votes -&gt; TF-IDF&lt;br&gt;(sublinear, L2-normalised)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="175" width="230" height="70" as="geometry"/></mxCell><mxCell id="hyb" value="Hybrid vector&lt;br&gt;50 % tags + 50 % text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="115" width="200" height="80" as="geometry"/></mxCell><mxCell id="sim" value="Cosine similarity&lt;br&gt;100 most similar games" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="260" width="200" height="70" as="geometry"/></mxCell><mxCell id="wil" value="Quality score&lt;br&gt;Wilson lower bound&lt;br&gt;of positive share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="260" width="220" height="70" as="geometry"/></mxCell><mxCell id="rank" value="Re-rank&lt;br&gt;0.8 similarity + 0.2 Wilson&lt;br&gt;-&gt; top 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="390" width="200" height="80" as="geometry"/></mxCell><mxCell id="app" value="Gradio app&lt;br&gt;table + header-image cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#dc2626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="540" width="200" height="80" as="geometry"/></mxCell><mxCell id="svd" value="Truncated SVD&lt;br&gt;371 tags -&gt; 100 dims (81 %)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="230" height="70" as="geometry"/></mxCell><mxCell id="km" value="k-means, k = 2 ... 20&lt;br&gt;elbow + silhouette&lt;br&gt;-&gt; 18 clusters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#fff