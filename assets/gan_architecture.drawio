<mxfile host="app.diagrams.net" pages="1"><diagram name="Steam thumbnail GAN: generator and discriminator" id="gan_architecture"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1680" pageHeight="640" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Steam thumbnail GAN: generator and discriminator" style="text;html=1;align=center;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1680" height="35" as="geometry"/></mxCell><mxCell id="g0" value="z ~ N(0, I)&lt;br&gt;128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="160" height="85" as="geometry"/></mxCell><mxCell id="g1" value="Linear + BN + ReLU&lt;br&gt;-&gt; 512 x 4 x 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="225" y="90" width="160" height="85" as="geometry"/></mxCell><mxCell id="g2" value="Upsample x2&lt;br&gt;Conv 3x3 + BN + ReLU&lt;br&gt;256 x 8 x 16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="160" height="85" as="geometry"/></mxCell><mxCell id="g3" value="Upsample x2&lt;br&gt;Conv 3x3 + BN + ReLU&lt;br&gt;128 x 16 x 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="90" width="160" height="85" as="geometry"/></mxCell><mxCell id="g4" value="Upsample x2&lt;br&gt;Conv 3x3 + BN + ReLU&lt;br&gt;64 x 32 x 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="90" width="160" height="85" as="geometry"/></mxCell><mxCell id="g5" value="Upsample x2&lt;br&gt;Conv 3x3 + BN + ReLU&lt;br&gt;