<mxfile host="app.diagrams.net" pages="1"><diagram name="How a GAN Learns: one training step" id="gan_training_loop"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="760" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="How a GAN Learns: one training step" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;html=1;align=center;fontSize=20;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="n1" value="Alternate two updates on every batch · the networks never share weights, only feedback" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1440" height="36" as="geometry"/></mxCell><mxCell id="n2" value="" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=black;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="700" height="610" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Step 1 · update the discriminator D&lt;/b&gt;" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="700" height="30" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;D learns to tell&lt;/b&gt; · real scores pushed above +1, fake scores below -1 (hinge)" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="680" height="34" as="geometry"/></mxCell><mxCell id="n5" value="Real&lt;br&gt;thumbnails" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="228" width="110" height="64" as="geometry"/></mxCell><mxCell id="n6" value="Noise z&lt;br&gt;~ N(0, I)" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=black;fontSize=11;" vertex="1" parent="1"><mxGeometry x="85" y="438" width="110" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Generator G&lt;br&gt;(frozen here)" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=black;fontSize=11;" vertex="1" parent="1"><mxGeometry x="265" y="438" width="110" height="64" as="geometry"/></mxCell><mxCell id="n8" value="Discriminator D" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=black;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="328" width="110" height="64" as="geometry"/></mxCell><mxCell id="n9" value="max(0, 1 - s_real)&lt;br&gt;+ max(0, 1 + s_fake)" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rhombus;whiteSpace=wrap;html=1;fillColor=#e6e6e6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="565" y="305" width="150" height="110" as="geometry"/></mxCell><mxCell id="e10" value="real" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;endArrow=block;html=1;strokeColor=black;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="195" y="260" as="sourcePoint"/><mxPoint x="445" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" value="" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;endArrow=block;html=1;strokeColor=black;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="195" y="470" as="sourcePoint"/><mxPoint x="265" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e12" value="fake" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;endArrow=block;html=1;strokeColor=black;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="438" as="sourcePoint"/><mxPoint x="500" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e13" value="scores" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;endArrow=block;html=1;strokeColor=black;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="360" as="sourcePoint"/><mxPoint x="565" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n14" value="update D&lt;br&gt;(lr 4e-4)" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#dc2626;fontSize=11;" vertex="1"