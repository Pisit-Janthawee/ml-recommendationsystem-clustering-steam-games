eometry"/></mxCell><mxCell id="n20" value="Generator G" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=black;fontSize=11;" vertex="1" parent="1"><mxGeometry x="995" y="328" width="110" height="64" as="geometry"/></mxCell><mxCell id="n21" value="Discriminator D&lt;br&gt;(frozen here)" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=black;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1175" y="328" width="110" height="64" as="geometry"/></mxCell><mxCell id="n22" value="- s_fake" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;rhombus;whiteSpace=wrap;html=1;fillColor=#e6e6e6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1315" y="320" width="110" height="80" as="geometry"/></mxCell><mxCell id="e23" value="" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;endArrow=block;html=1;strokeColor=black;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="360" as="sourcePoint"/><mxPoint x="995" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e24" value="fake" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;endArrow=block;html=1;strokeColor=black;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105" y="360" as="sourcePoint"/><mxPoint x="1175" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="score" style="sketch=