<mxfile host="app.diagrams.net" pages="1"><diagram name="How a GAN Learns: one training step" id="gan_training_loop"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="860" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="How a GAN Learns: one training step" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="n1" value="Alternate two updates on every batch · the networks never share weights, only feedback" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1440" height="36" as="geometry"/></mxCell><mxCell id="n2" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="700" height="710" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Step 1 · update the discriminator D&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="700" height="30" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;D learns to tell&lt;/b&gt;&lt;br&gt;real scores pushed above +1, fake scores below -1 (hinge)" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="680" height="70" as="geometry"/></mxCell><mxCell id="n5" value="Real&lt;br&gt;thumbnails" style="fontFamily=Helvetica;fontColor=#000000;shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="228" width="110" height="64" as="geometry"/></mxCell><mxCell id="n6" value="Noise z&lt;br&gt;~ N(0, I)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="85" y="438" width="110" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Generator G&lt;br&gt;(frozen here)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="265" y="438" width="110" height="64" as="geometry"/></mxCell><mxCell id="n8" value="Discriminator D" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="425" y="328" width="110" height="64" as="geometry"/></mxCell><mxCell id="n9" value="max(0, 1 - s_real)&lt;br&gt;+ max(0, 1 + s_fake)" style="fontFamily=Helvetica;fontColor=#000000;rhombus;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="565" y="305" width="150" height="110" as="geometry"/></mxCell><mxCell id="e10" value="real" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="fake" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="scores" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="update D&lt;br&gt;(lr 4e-4)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="585" y="568" width="110" height="64" as="geometry"/></mxCell><mxCell id="e15" value="gradient" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=2;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n9" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Inside the D update&lt;/b&gt;&lt;br&gt;Adam, betas (0, 0.9), lr 4e-4 (4 x G: TTUR)&lt;br&gt;spectral norm caps how fast D can change&lt;br&gt;new weights are used on the next batch" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="330" height="120" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="" style="fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="700" height="710" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Step 2 · update the generator G&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="115" width="700" height="30" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;G learns to fool&lt;/b&gt;&lt;br&gt;G changes its weights so that D scores its fakes higher" style="fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="740" width="680" height="70" as="geometry"/></mxCell><mxCell id="n21" value="Noise z&lt;br&gt;~ N(0, I)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="805" y="328" width="110" height="64" as="geometry"/></mxCell><mxCell id="n22" value="Generator G" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="975" y="328" width="110" height="64" as="geometry"/></mxCell><mxCell id="n23" value="Discriminator D&lt;br&gt;(frozen here)" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" 